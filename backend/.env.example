# ── Volvo Cars developer app ────────────────────────────────────────────────
# From https://developer.volvocars.com/account/#your-api-applications
VOLVO_CLIENT_ID=
VOLVO_CLIENT_SECRET=
VOLVO_VCC_API_KEY=

# Must EXACTLY match a redirect URI registered on the Volvo app.
# Local dev:  http://localhost:8000/auth/callback
# Production: https://volvowatch.kavaleff.com/auth/callback
VOLVO_REDIRECT_URI=http://localhost:8000/auth/callback

# Space-separated. Release 1 = default-tier scopes only (no Volvo restricted-scope
# review needed). Add conve:lock conve:unlock conve:honk_flash location:read for
# Release 2.
VOLVO_SCOPES="openid conve:fuel_status conve:battery_charge_level conve:odometer_status conve:doors_status conve:windows_status conve:lock_status conve:diagnostics_engine_status conve:diagnostics_workshop conve:climatization_start_stop conve:commands conve:command_accessibility conve:trip_statistics conve:vehicle_relation conve:warnings conve:tyre_status conve:engine_status energy:state:read energy:capability:read"

# ── Service ─────────────────────────────────────────────────────────────────
# Public base URL the watch and Volvo callbacks hit. Local: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# sqlite:///./data/volvowatch.db  (path is relative to the backend/ dir)
DATABASE_URL=sqlite:///./data/volvowatch.db

# `python -m app.cli gen-keys` prints fresh values for these two.
FERNET_KEY=
DEVICE_TOKEN_PEPPER=

# Seconds to cache a vehicle's /v1/status upstream response.
STATUS_CACHE_TTL=60

# Volvo only reports fuel in litres. Set your usable tank size to also get a
# fuel %. XC60 PHEV ~= 60. Leave 0 to omit.
FUEL_TANK_LITRES=0

# Comma-separated extra CORS / trusted origins (usually leave blank).
EXTRA_ALLOWED_ORIGINS=
