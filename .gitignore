# claude-docs owns these — keep them out of this repo's status
RESEARCH.md
SPEC.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local config / data / secrets
.env
.env.*
!.env.example
data/
*.sqlite
*.sqlite-journal
*.db
.refresh_token
/tokens
/tallimedia_api_values
*.secret
*_response.json
probe_output*.txt
# never commit captured tokens/credentials
**/access_token*
**/refresh_token*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!watch/.vscode/settings.json
!watch/.vscode/launch.json

# Connect IQ build output
watch/bin/
*.iq
*.prg
*.prg.debug.xml

# dist/ is the tracked release-artifact folder (see claude-docs root
# CLAUDE.md "Release artifacts" convention) — only build-release.sh's output
# belongs here, since that script refuses to build with a DevConfig.mc
# device token set. A personalized/sideload build with an embedded token
# (built by hand, bypassing build-release.sh) must NEVER be copied in here —
# that's exactly what happened before (tester builds found + removed
# 2026-10-13); the rule is discipline, not a gitignore block, since dist/
# itself has to be reachable from other machines.
!dist/
!dist/**

# raw sim captures — framed into store/screenshot-*.png by make_store_art.py
watch/store/capture-*.png

# ad-hoc verification screenshots (File -> Save Screen Capture), not store assets
watch/store/pg*.png
watch/store/pairing.png
html/*.zip

# scripts/ runtime state — lives only on public-vm, not the repo
backend/scripts/.last_user_count

# Monkey C compiler intermediates — build output, not source. Untracked
# 2026-10-27 after a public-repo audit found them committed by accident.
watch/gen/
watch/internal-mir/
watch/mir/

# Editor config — not meant for a public source repo. Untracked 2026-10-27,
# same audit as above.
watch/.vscode/
watch/.project
